# API_UPSTREAM is substituted at container start.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Five files of 10 MB plus multipart overhead.
    client_max_body_size 64m;

    location /api/ {
        # Keep the upstream name as Host so the environment ingress routes to the API app.
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Imports wait for extraction and OCR before responding.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Hashed bundles never change their bytes.
    location ~* "\.[0-9a-f]{16,}\.(js|css|map)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* "\.(js|css|map|woff2?|png|jpe?g|svg|ico)$" {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
